{
  "name": "sdadataai-bw-rfc-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing dynamic SAP BW and S/4HANA RFC calls, scoped to SDADATAAI. Deployed standalone on Cloud Foundry, called by SDADATAAI's CAP backend over HTTP with Basic Auth.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test-connection": "node test-connection.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sap-cloud-sdk/connectivity": "^3.0.0",
    "@sap-cloud-sdk/http-client": "^3.0.0",
    "open-rfc": "^0.2.5",
    "express": "^4.19.2",
    "basic-auth": "^2.0.1",
    "zod": "^3.23.8",
    "hyparquet": "^1.32.0",
    "hyparquet-writer": "^0.18.0"
  }
}
