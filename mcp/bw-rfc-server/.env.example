# Copy to .env for local testing only — never commit a real .env.
# On Cloud Foundry, set these with `cf set-env sdadataai-bw-rfc-mcp <KEY> <VALUE>`
# then `cf restage sdadataai-bw-rfc-mcp`, not via this file.

# Private npm feed token for the @sap-rfc scope (pulls @sap-rfc/node-rfc-library)
SAP_NPM_REGISTRY_TOKEN=

# Basic Auth users calling this MCP server — defaults match server.js if unset
MCP_USER_1=AYMANK
MCP_PASS_1=AYMANK
MCP_USER_2=SAIREDDY
MCP_PASS_2=SAIREDDY

# SDADATAAI target system — fill in with real values when ready
SDADATAAI_SAP_ASHOST=
SDADATAAI_SAP_SYSNR=00
SDADATAAI_SAP_CLIENT=
SDADATAAI_SAP_USER=
SDADATAAI_SAP_PASSWD=
